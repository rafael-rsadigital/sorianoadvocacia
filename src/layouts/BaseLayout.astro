---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Soriano Advocacia | Advocacia',
  description = 'Atuação jurídica com atenção especial à regularização de imóveis e ao Direito Imobiliário.'
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#037580" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="google-site-verification" content="TW0pGG_UTdbxlyW92OHy69JgpkfTgtzixjuM9QOsMgQ" />
    <link rel="canonical" href="https://sorianoadvocacia.vercel.app/" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Soriano Advocacia Advocacia" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sorianoadvocacia.vercel.app/" />
    <meta property="og:image" content="https://sorianoadvocacia.vercel.app/images/soriano-hero.jpg" />
    <meta property="og:image:alt" content="Soriano Advocacia Advocacia em Guarujá" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://sorianoadvocacia.vercel.app/images/soriano-hero.jpg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
