---
import BaseLayout from '../layouts/BaseLayout.astro';

const phone = '5513981840502';
const topicLink = (topic: string) => 'https://wa.me/' + phone + '?text=' + encodeURIComponent('Olá! Vim pelo link da Soriano e Freitas e gostaria de informações sobre ' + topic + '.');
const whatsapp = 'https://wa.me/' + phone + '?text=' + encodeURIComponent('Olá! Vim pelo link da Soriano e Freitas e gostaria de mais informações.');
const instagram = 'https://www.instagram.com/soriano.advocacia/';
const review = 'https://g.page/r/CZIrYS7rmuszEBM/review';
const maps = 'https://www.google.com/maps/search/?api=1&query=Soriano%20e%20Freitas%20Jur%C3%ADdico%2C%20Guaruj%C3%A1';
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3645.09635098782!2d-46.27989952465682!3d-23.992374478505955!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94d1ffaffc279671%3A0x33eb9aeb2e612b92!2sSoriano%20e%20Freitas%20Juridico!5e0!3m2!1spt-BR!2sbr!4v1795058185974!5m2!1spt-BR!2sbr';
const rsa = 'https://wa.me/5513988507195?text=' + encodeURIComponent('Olá! Vim pelo site da Soriano e Freitas e gostaria de falar sobre um projeto digital.');
const areas = [
  { title: 'Regularização de Imóveis', href: topicLink('regularização de imóveis'), icon: 'home' },
  { title: 'Direito de Família', href: topicLink('Direito de Família'), icon: 'family' },
  { title: 'Direito do Consumidor', href: topicLink('Direito do Consumidor'), icon: 'cart' },
  { title: 'Direito Bancário', href: topicLink('Direito Bancário'), icon: 'bank' },
  { title: 'Direito Administrativo', href: topicLink('Direito Administrativo'), icon: 'court' },
  { title: 'Direito dos Concursos Públicos', href: topicLink('questões de concursos públicos, nomeação e posse'), icon: 'trophy' },
];
---
<BaseLayout title="Soriano e Freitas | Escritório de Advocacia em Guarujá" description="Soriano e Freitas Advocacia em Guarujá. Regularização de imóveis, Direito Imobiliário, Família, Consumidor, Bancário, Administrativo e Concursos Públicos.">
  <main class="link-page">
    <div class="page-bg" aria-hidden="true"></div>
    <div class="link-container">
      <header class="profile">
        <div class="brand-mark" aria-label="Monograma Soriano e Freitas">
          <svg viewBox="0 0 180 142" role="img" aria-hidden="true">
            <text x="42" y="89" class="mark-s">S</text><text x="84" y="111" class="mark-f">F</text>
            <path d="M12 104 C49 48 105 33 165 48 C118 34 61 52 12 104Z" class="mark-swoosh"/>
          </svg>
        </div>
        <p class="firm-name">SORIANO E FREITAS</p>
        <div class="firm-type"><span></span> A D V O C A C I A <span></span></div>
        <h1>Escritório de Advocacia<br/>em Guarujá</h1>
        <span class="gold-rule"></span>
      </header>

      <nav class="main-links" aria-label="Canais oficiais">
        <a class="link-button social-button" href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Fale conosco pelo WhatsApp">
          <span class="social-icon whatsapp">
            <img src="https://cdn.simpleicons.org/whatsapp/FFFFFF" alt="" width="34" height="34" loading="lazy" />
          </span><span class="button-divider"></span><span class="button-title">Fale Conosco pelo WhatsApp</span><span class="button-arrow">›</span>
        </a>
        <a class="link-button social-button" href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Nosso Instagram">
          <span class="social-icon instagram">
            <img src="https://cdn.simpleicons.org/instagram/E4405F" alt="" width="34" height="34" loading="lazy" />
          </span><span class="button-divider"></span><span class="button-title">Nosso Instagram</span><span class="button-arrow">›</span>
        </a>
        <a class="link-button social-button" href={review} target="_blank" rel="noopener noreferrer" aria-label="Avalie no Google">
          <span class="social-icon google-review"><svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11a9.4 9.4 0 0 1-4.1 6.2v5.1h6.6c3.9-3.6 6.1-8.8 6.1-15Z"/><path fill="#34A853" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.6-5.1c-1.8 1.2-4.1 2-6.9 2-5.3 0-9.8-3.6-11.4-8.4H5.8v5.3A20 20 0 0 0 24 44Z"/><path fill="#FBBC05" d="M12.6 27.6a12 12 0 0 1 0-7.2v-5.3H5.8a20 20 0 0 0 0 17.8l6.8-5.3Z"/><path fill="#EA4335" d="M24 11.9c3 0 5.7 1 7.8 3.1l5.8-5.8C34.1 5.9 29.5 4 24 4A20 20 0 0 0 5.8 15.1l6.8 5.3C14.2 15.5 18.7 11.9 24 11.9Z"/></svg></span><span class="button-divider"></span><span class="button-title">Avalie no Google</span><span class="button-arrow">›</span>
        </a>
        <a class="link-button social-button" href={maps} target="_blank" rel="noopener noreferrer" aria-label="Nosso endereço no Google Maps">
          <span class="social-icon maps-icon">
            <svg viewBox="0 0 24 32" aria-hidden="true"><path fill="#4285F4" d="M12 1C5.8 1 1.5 5.7 1.5 11.5c0 7.2 10.5 19.2 10.5 19.2S22.5 18.7 22.5 11.5C22.5 5.7 18.2 1 12 1Z"/><path fill="#34A853" d="M12 30.7S1.5 18.7 1.5 11.5c0-2.2.6-4.2 1.8-5.9L12 11.5Z"/><path fill="#FBBC04" d="M3.3 5.6A10.4 10.4 0 0 1 12 1v10.5Z"/><path fill="#EA4335" d="M12 1c4 0 7.3 1.8 9.1 4.8L12 11.5Z"/><circle cx="12" cy="11.5" r="3.8" fill="#fff"/></svg>
          </span><span class="button-divider"></span><span class="button-title">Nosso Endereço no Google Maps</span><span class="button-arrow">›</span>
        </a>
      </nav>

      <section class="areas" aria-labelledby="areas-title">
        <div class="section-label"><span></span><h2 id="areas-title">NOSSAS ÁREAS DE ATUAÇÃO</h2><span></span></div>
        <div class="area-grid">
          {areas.map((area) => <a class="link-button area-button" href={area.href} target="_blank" rel="noopener noreferrer">
            <span class="area-icon" aria-hidden="true">
              {area.icon === 'home' && <svg viewBox="0 0 32 32"><path d="M3 14.5 16 4l13 10.5M7 12v16h7V18h5v10h6V12"/></svg>}
              {area.icon === 'family' && <svg viewBox="0 0 32 32"><circle cx="16" cy="8" r="4"/><circle cx="6.5" cy="12" r="3"/><circle cx="25.5" cy="12" r="3"/><path d="M8 28v-5a8 8 0 0 1 16 0v5M1.5 27v-4a5 5 0 0 1 5-5h2M30.5 27v-4a5 5 0 0 0-5-5h-2"/></svg>}
              {area.icon === 'cart' && <svg viewBox="0 0 32 32"><path d="M3 5h4l3.2 17h16.5l3-12H8M12 27h.1M24 27h.1"/><circle cx="12" cy="27" r="1.8"/><circle cx="24" cy="27" r="1.8"/></svg>}
              {area.icon === 'bank' && <svg viewBox="0 0 32 32"><path d="m3 11 13-7 13 7H3ZM5 27h22M7 12v13M13 12v13M19 12v13M25 12v13M3 29h26"/></svg>}
              {area.icon === 'court' && <svg viewBox="0 0 32 32"><path d="m3 10 13-7 13 7H3ZM5 12v14M11 12v14M21 12v14M27 12v14M3 28h26M3 31h26M16 12v14"/></svg>}
              {area.icon === 'trophy' && <svg viewBox="0 0 32 32"><path d="M10 4h12v8a6 6 0 0 1-12 0V4ZM10 7H4v4a6 6 0 0 0 6 6M22 7h6v4a6 6 0 0 1-6 6M16 18v7M10 28h12M12 25h8"/></svg>}
            </span><span class="area-title">{area.title}</span><span class="button-arrow">›</span>
          </a>)}
        </div>
      </section>

      <section class="map-section" aria-label="Localização do escritório">
        <div class="map-frame"><iframe src={mapEmbed} title="Localização da Soriano e Freitas Jurídico em Guarujá" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
      </section>

      <footer class="page-footer">
        <div class="footer-address"><span class="footer-pin">⌖</span><address>Av. Adhemar de Barros, 1060 – Sala 12<br/>Jardim Helena Maria, Guarujá – SP</address></div>
        <span class="footer-separator"></span>
        <a class="footer-phone" href="tel:+5513981840502"><span class="phone-symbol">♧</span><span><strong>(13) 98184-0502</strong><small>Atendimento via WhatsApp</small></span></a>
      </footer>
      <div class="credit">Desenvolvido por <a href={rsa} target="_blank" rel="noopener noreferrer">RSA Digital</a></div>
    </div>
  </main>
</BaseLayout>
